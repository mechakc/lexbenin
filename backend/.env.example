# Exemple de configuration backend — copie ce fichier en `.env` et adapte les valeurs.
# NE JAMAIS committer un `.env` contenant de vraies clés (voir .gitignore : .env*.local).

# --- Génération & embeddings (Mistral) ---
# Clé API Mistral, requise pour EMBEDDING_BACKEND=mistral et LLM_BACKEND=mistral.
# https://console.mistral.ai
MISTRAL_API_KEY=ta_cle_mistral

# Backend d'embeddings : "tfidf" (test local, aucune clé requise) | "e5" | "mistral" (prod)
EMBEDDING_BACKEND=mistral

# Backend de génération : "mock" (test, aucun appel réseau) | "mistral" (prod)
LLM_BACKEND=mistral

# Seuil de distance vectorielle pour le garde-fou "hors périmètre".
# À CALIBRER sur ton backend d'embeddings réel (voir rag/calibrate_threshold.py) —
# l'échelle diffère entre tfidf/e5/mistral. Laisser vide = garde-fou désactivé.
DISTANCE_THRESHOLD=

# Double passage LLM pour vérifier chaque citation ("true"/"false").
# Coûte un appel API supplémentaire par question.
VERIFY_ANSWERS=false

# --- Authentification ---
# Secret de signature des JWT. OBLIGATOIREMENT une valeur aléatoire et secrète en prod
# (jamais la valeur par défaut du code). Ex. : openssl rand -hex 32
AUTH_SECRET_KEY=une_valeur_aleatoire_et_secrete

# --- Base de données ---
# SQLite en local ; une URL Postgres en prod (ex. postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./lexbenin.db

# --- CORS ---
# Origines autorisées, séparées par des virgules. "*" autorise tout (dev uniquement).
# En prod, restreindre à l'URL du frontend, ex. : https://lexbenin.vercel.app
ALLOWED_ORIGINS=*
